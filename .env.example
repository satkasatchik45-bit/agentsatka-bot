# =======================================================
# ANTIGRAVITY AVTONOM AGENTI SOZLAMALARI
# =======================================================

# 1. Google Gemini API Kaliti (Internet mavjud bo'lganda eng yuqori darajada ishlash uchun)
# Bepul olish manzili: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Sun'iy intellekt modeli
MODEL_NAME=gemini-2.5-flash

# 3. Mahalliy LLM sozlamalari (100% Internetsiz ishlash uchun Ollama)
# Agar kompyuteringizda Ollama o'rnatilgan bo'lsa:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 4. Agent ishlash tartibi (PREFERRED_MODE):
# auto     -> Avtomatik (Internet bo'lsa Gemini, bo'lmasa Ollama yoki Mahalliy Miya)
# offline  -> Faqat internetsiz mahalliy boshqaruv rejimi
# local    -> Faqat lokal Ollama modeli orqali
# cloud    -> Faqat bulutli Gemini orqali
PREFERRED_MODE=auto

# 5. Telegram Bot (ixtiyoriy, agar masofadan telefondan boshqarmoqchi bo'lsangiz)
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USERS=

# 6. Ishchi papka va chegaralar
# WORKSPACE_DIR=D:/agent/workspace
COMMAND_TIMEOUT=90
MAX_TOOL_STEPS=20
